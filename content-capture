#!/usr/bin/env bash
# content-capture — 内容收录统一 CLI 入口
#
#   content-capture collect [--max-seconds N] [--language L] [--skip-transcribe] <链接> [输出目录]
#   content-capture detect  <链接或分享口令>
#   content-capture setup   [--check]
#   content-capture doctor
#   content-capture transcribe <音频> [--max-seconds N] [--language L]
#   content-capture index add --doc 正文.md --title T --platform P --tags T --summary S [--url 原链接] [--index 索引.md]
#   content-capture help | --help
#   content-capture --version
#
# 公众号、抖音、小红书、X、YouTube 都走 collect，由 detect 按链接分派。
# 退出码：0 成功；1 用法错误；2 不支持的链接；3 依赖缺失；4 下载失败；
#         5 转录失败；6 公众号抓取失败；10 工具未就绪。
# doctor 全部就绪为 0，有缺失为 1。
set -uo pipefail

# 解析软链：放进 PATH 的软链也要找到真实的技能目录（老 macOS 的 readlink 没有 -f，用 python3 兜底）
CC_SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}" 2>/dev/null \
  || printf '%s' "${BASH_SOURCE[0]}")"
SKILL_DIR="$(cd "$(dirname "$CC_SELF")" && pwd)"
# shellcheck source=scripts/lib.sh
if ! source "$SKILL_DIR/scripts/lib.sh"; then
  echo "content-capture: 加载 $SKILL_DIR/scripts/lib.sh 失败（文件缺失或出错）。请确认技能目录完整，软链要指向技能目录里的真实文件。" >&2
  exit 3
fi

CC_VERSION="0.2.0"

cmd_help() {
  cat <<'EOF'
content-capture — 把一条链接变成文案 + 内容解析（抖音、小红书、X、YouTube、微信公众号）

用法:
  content-capture collect [--max-seconds N] [--language L] [--skip-transcribe] [--index 索引.md] <链接> [输出目录]
  content-capture detect <链接或分享口令>
  content-capture setup [--check]
  content-capture doctor
  content-capture transcribe <音频> [--max-seconds N] [--language L]
  content-capture index add --doc <正文.md> --title <标题> --platform <平台> --tags <标签> --summary <摘要> [--url <原链接>] [--index <索引.md>]
  content-capture index path [--index <索引.md>]
  content-capture help | --help
  content-capture --version

子命令:
  collect      按链接自动识别平台并收录（视频会转录，公众号走 wxfetch）
  detect       只在 stdout 输出平台名：douyin|xhs|x|youtube|wechat|unknown
               可从分享口令文本里抽出第一个 URL 再判断
  setup        安装或补齐依赖（调用 setup.sh，其中会跑 wxfetch/setup.sh）
  doctor       检查依赖、模型、抖音 API、wxfetch 虚拟环境，逐项 ok / 缺失
  transcribe   调用 scripts/transcribe.py，默认模型 small，默认自动识别语言

--language L   转录语言：auto（自动识别）、zh、en……也可用环境变量 CC_LANGUAGE。
               collect 不指定时：抖音、小红书默认 zh；X、YouTube 默认 auto。
抖音图集、小红书图文只保存图片和文案，不做转录。

index        维护总索引 索引.md（5 列：标题 | 来源（平台） | 标签 | 摘要 | 文档链接）。
             同一原链接或同一正文文档只更新那一行。collect 成功后会按原链接预留一行
             （标签、摘要留空），summary.json 的 doc 字段是正文 Markdown 应写到的路径。
             索引位置：--index > CC_INDEX_FILE > $CC_OUTPUT_ROOT/索引.md；
             CC_OUTPUT_ROOT 默认 ./content-capture-out，可写进 ~/.config/content-capture/config.sh。

collect 退出码：0 成功；1 用法错误；2 不支持的链接；3 依赖缺失；
4 下载失败；5 转录失败；6 公众号抓取失败；10 工具未就绪。
EOF
}

cmd_version() {
  printf 'content-capture %s\n' "$CC_VERSION"
}

cmd_detect() {
  if [ $# -eq 0 ]; then
    cc_err "用法: content-capture detect <链接或分享口令>"
    exit 1
  fi
  # 允许多个参数拼成一段分享口令
  local text
  text="$*"
  cc_detect_platform "$text"
}

cmd_setup() {
  bash "$SKILL_DIR/setup.sh" "$@"
}

# ---------- doctor ----------
cmd_doctor() {
  local missing=0
  echo "== content-capture doctor ==" >&2
  echo "   skill=$SKILL_DIR" >&2
  echo "   tools=$CC_TOOLS_DIR" >&2
  echo "   venv=$CC_VENV" >&2
  echo "   whisper=$CC_WHISPER_MODEL" >&2
  echo "   output_root=$CC_OUTPUT_ROOT" >&2
  echo "   index=$CC_INDEX_FILE" >&2

  if command -v yt-dlp >/dev/null 2>&1; then
    cc_ok "依赖 yt-dlp: $(yt-dlp --version 2>/dev/null | head -1)"
  else
    cc_bad "依赖 yt-dlp"
    missing=1
  fi
  if command -v ffmpeg >/dev/null 2>&1; then
    cc_ok "依赖 ffmpeg: $(ffmpeg -version 2>/dev/null | head -1)"
  else
    cc_bad "依赖 ffmpeg"
    missing=1
  fi
  if command -v ffprobe >/dev/null 2>&1; then
    cc_ok "依赖 ffprobe"
  else
    cc_bad "依赖 ffprobe（通常随 ffmpeg 一起安装）"
    missing=1
  fi
  if command -v uv >/dev/null 2>&1; then
    cc_ok "依赖 uv: $(uv --version 2>/dev/null)"
  else
    cc_bad "依赖 uv"
    missing=1
  fi
  if command -v python3 >/dev/null 2>&1; then
    cc_ok "依赖 python3: $(python3 --version 2>&1)"
  else
    cc_bad "依赖 python3"
    missing=1
  fi

  local py="${CC_VENV}/bin/python"
  if [ -x "$py" ] && "$py" -c 'import faster_whisper, av, importlib.metadata as m; assert m.version("faster-whisper").startswith("1.2."); assert m.version("av").startswith("13.")' >/dev/null 2>&1; then
    cc_ok "依赖 转录环境: $CC_VENV (faster-whisper 1.2.x + av 13.x)"
  else
    cc_bad "依赖 转录环境未就绪: $CC_VENV"
    missing=1
  fi

  if [ -f "$CC_TIKTOK_DIR/main.py" ]; then
    cc_ok "依赖 TikTokDownloader: $CC_TIKTOK_DIR"
  else
    cc_bad "依赖 TikTokDownloader 不在 $CC_TIKTOK_DIR"
    missing=1
  fi
  if [ -f "$CC_XHS_DIR/main.py" ]; then
    cc_ok "依赖 XHS-Downloader: $CC_XHS_DIR"
  else
    cc_bad "依赖 XHS-Downloader 不在 $CC_XHS_DIR"
    missing=1
  fi

  if cc_is_model_path "$CC_WHISPER_MODEL"; then
    cc_ok "模型: $CC_WHISPER_MODEL"
  else
    case "$CC_WHISPER_MODEL" in
      small|tiny|base|medium|large-v2|large-v3)
        cc_ok "模型名: $CC_WHISPER_MODEL（首次转录时由 faster-whisper 按需下载）"
        ;;
      *)
        if [ -e "$CC_WHISPER_MODEL" ]; then
          cc_bad "模型路径存在但看起来不是模型目录: $CC_WHISPER_MODEL"
        else
          cc_bad "模型未就绪: $CC_WHISPER_MODEL"
        fi
        missing=1
        ;;
    esac
  fi

  local code
  code="$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 2 --max-time 5 "$CC_DOUYIN_API/" 2>/dev/null || true)"
  if [ -n "$code" ] && [ "$code" != "000" ]; then
    cc_ok "抖音 API: $CC_DOUYIN_API (HTTP $code)"
  else
    cc_bad "抖音 API: $CC_DOUYIN_API 无响应"
    missing=1
  fi

  local wxvenv="${WXFETCH_VENV:-$HOME/.local/share/wxfetch/venv}"
  local wxpy="$wxvenv/bin/python"
  if [ -x "$wxpy" ] && "$wxpy" -c 'import requests, bs4, lxml, markdownify' >/dev/null 2>&1; then
    cc_ok "wxfetch 虚拟环境: $wxvenv"
  else
    cc_bad "wxfetch 虚拟环境未就绪: $wxvenv"
    missing=1
  fi
  if [ ! -x "$SKILL_DIR/wxfetch/wxfetch" ]; then
    cc_bad "wxfetch 入口脚本: $SKILL_DIR/wxfetch/wxfetch"
    missing=1
  else
    cc_ok "wxfetch 入口脚本: $SKILL_DIR/wxfetch/wxfetch"
  fi

  if [ "$missing" -eq 0 ]; then
    echo "== READY ==" >&2
    exit 0
  fi
  echo "== NOT READY（见上方 [MISS]；安装请运行: content-capture setup）==" >&2
  exit 1
}

# ---------- transcribe ----------
cmd_transcribe() {
  local media="" max_seconds="" language="${CC_LANGUAGE:-auto}"
  local usage_t="用法: content-capture transcribe <音频或视频> [--max-seconds N] [--language auto|zh|en|...]"
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        echo "$usage_t" >&2
        exit 0
        ;;
      --max-seconds)
        [ $# -ge 2 ] || { cc_err "$usage_t"; exit 1; }
        max_seconds="$2"
        shift 2
        ;;
      --max-seconds=*)
        max_seconds="${1#--max-seconds=}"
        shift
        ;;
      --language|-l)
        [ $# -ge 2 ] || { cc_err "$usage_t"; exit 1; }
        language="$2"
        shift 2
        ;;
      --language=*)
        language="${1#--language=}"
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        cc_err "未知参数: $1"
        echo "$usage_t" >&2
        exit 1
        ;;
      *)
        if [ -z "$media" ]; then
          media="$1"
        else
          cc_err "多余参数: $1"
          exit 1
        fi
        shift
        ;;
    esac
  done
  [ -n "$media" ] || { cc_err "$usage_t"; exit 1; }
  local py="${CC_VENV}/bin/python"
  if [ ! -x "$py" ]; then
    cc_err "找不到转录环境: $CC_VENV （先运行 content-capture setup，或设置 CC_VENV）"
    exit 3
  fi
  local args=("$py" "$SKILL_DIR/scripts/transcribe.py" --language "$language" "$media")
  if [ -n "$max_seconds" ]; then
    args+=(--max-seconds "$max_seconds")
  fi
  "${args[@]}"
}

# ---------- index ----------
cmd_index() {
  if [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    python3 "$SKILL_DIR/scripts/cc_index.py" --help
    [ $# -eq 0 ] && exit 1
    exit 0
  fi
  case "$1" in
    add|path) ;;
    *) cc_err "未知 index 子命令: $1（可用: add、path）"; exit 1 ;;
  esac
  CC_INDEX_FILE="$CC_INDEX_FILE" CC_OUTPUT_ROOT="$CC_OUTPUT_ROOT" python3 "$SKILL_DIR/scripts/cc_index.py" "$@"
}

# ---------- collect（原 collect.sh 逻辑） ----------
cmd_collect() {
  local MAX_SECONDS="${CC_MAX_SECONDS:-}"
  local SKIP_TRANSCRIBE=0
  local LANGUAGE="${CC_LANGUAGE:-}"
  local INDEX_FILE="$CC_INDEX_FILE"
  local URL=""
  local OUT=""

  collect_usage() {
    echo "用法: content-capture collect [--max-seconds N] [--language auto|zh|en|...] [--skip-transcribe] [--index 索引.md] <链接> [输出目录]" >&2
    exit 1
  }

  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) collect_usage ;;
      --skip-transcribe) SKIP_TRANSCRIBE=1; shift ;;
      --max-seconds)
        [ $# -ge 2 ] || collect_usage
        MAX_SECONDS="$2"
        shift 2
        ;;
      --max-seconds=*)
        MAX_SECONDS="${1#--max-seconds=}"
        shift
        ;;
      --language|-l)
        [ $# -ge 2 ] || collect_usage
        LANGUAGE="$2"
        shift 2
        ;;
      --language=*)
        LANGUAGE="${1#--language=}"
        shift
        ;;
      --index)
        [ $# -ge 2 ] || collect_usage
        INDEX_FILE="$2"
        shift 2
        ;;
      --index=*)
        INDEX_FILE="${1#--index=}"
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        cc_err "未知参数: $1"
        collect_usage
        ;;
      *)
        if [ -z "$URL" ]; then
          URL="$1"
        elif [ -z "$OUT" ]; then
          OUT="$1"
        else
          cc_err "多余参数: $1"
          collect_usage
        fi
        shift
        ;;
    esac
  done

  [ -n "$URL" ] || collect_usage

  local extracted
  extracted="$(cc_extract_url "$URL")"
  if [ -n "$extracted" ]; then
    URL="$extracted"
  fi

  if [ -z "$OUT" ]; then
    OUT="$CC_OUTPUT_ROOT/$(date +%Y%m%d-%H%M%S)-$(cc_slug "$URL")"
  fi
  mkdir -p "$OUT"
  OUT="$(cd "$OUT" && pwd)"

  local PLATFORM
  PLATFORM="$(cc_detect_platform "$URL")"
  local SUMMARY="$OUT/summary.json"

  write_summary() {
    CC_INDEX_PY="$SKILL_DIR/scripts/cc_index.py" CC_INDEX_FILE="$INDEX_FILE" \
    python3 - "$SUMMARY" "$OUT" "$URL" "$PLATFORM" "$1" "$2" "$3" <<'PY'
import json, os, subprocess, sys
from pathlib import Path

summary_path, out, url, platform, ok, code, message = sys.argv[1:8]
out_p = Path(out)
meta = {}
mp = out_p / "meta.json"
if mp.exists():
    try:
        meta = json.loads(mp.read_text(encoding="utf-8"))
    except Exception:
        meta = {}

if not meta:
    arts = list(out_p.rglob("article.json"))
    if arts:
        try:
            art = json.loads(arts[0].read_text(encoding="utf-8"))
            meta = {
                "title": art.get("title") or "",
                "author": art.get("author") or art.get("account_name") or "",
                "account_name": art.get("account_name"),
                "article_id": art.get("article_id"),
                "files": art.get("files") or {},
            }
        except Exception:
            pass

files = {
    "meta": str(mp) if mp.exists() else None,
    "transcript": None,
    "transcript_plain": None,
    "media": [],
    "images": [],
    "markdown": [],
    "other": [],
}
media_ext = {".mp4", ".m4a", ".mp3", ".webm", ".mkv", ".mov", ".wav", ".aac", ".opus"}
image_ext = {".jpg", ".jpeg", ".png", ".webp", ".gif", ".heic", ".heif", ".avif"}
skip_names = {"summary.json", "yt-dlp.log", "xhs_cli.log", "share_response.json", "detail_response.json"}
for p in sorted(out_p.rglob("*")):
    if not p.is_file():
        continue
    rel = str(p)
    name = p.name
    if name in skip_names:
        continue
    suf = p.suffix.lower()
    if name == "transcript.txt":
        files["transcript"] = rel
    elif name == "transcript_plain.txt":
        files["transcript_plain"] = rel
    elif name.endswith(".md") or name == "article.md":
        files["markdown"].append(rel)
    elif suf in media_ext:
        files["media"].append(rel)
    elif suf in image_ext:
        files["images"].append(rel)
    elif name in {"meta.json", "article.json"} or suf == ".json":
        pass
    else:
        if name not in {"audio.wav", "audio_16k_mono.wav"}:
            files["other"].append(rel)

title = meta.get("title") or ""
author = meta.get("author") or meta.get("account_name") or ""
payload = {
    "ok": ok == "ok",
    "status": "ok" if ok == "ok" else "error",
    "error_code": int(code),
    "message": message,
    "platform": platform,
    "kind": meta.get("kind") or ("article" if platform == "wechat" else ("video" if meta else None)),
    "url": url,
    "title": title,
    "author": author,
    "out_dir": out,
    "files": files,
}
if payload["ok"]:
    # 收录成功：按原链接在总索引里预留一行（标签、摘要留空），doc 是正文 Markdown 应写的位置
    index_file = os.path.abspath(os.path.expanduser(os.environ["CC_INDEX_FILE"]))
    r = subprocess.run(
        [sys.executable, os.environ["CC_INDEX_PY"], "reserve", "--url", url, "--platform", platform,
         "--title", title, "--index", index_file],
        capture_output=True, text=True,
    )
    payload["index"] = index_file
    if r.returncode == 0 and r.stdout.strip():
        payload["doc"] = r.stdout.strip().splitlines()[-1]
    else:
        payload["doc"] = None
        payload["index_error"] = (r.stderr or "").strip()[-500:] or f"退出码 {r.returncode}"
        print("  [ERR ] 总索引预留失败: " + payload["index_error"], file=sys.stderr)
Path(summary_path).write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
print(json.dumps(payload, ensure_ascii=False, indent=2))
PY
  }

  fail() {
    local code="$1" msg="$2"
    cc_err "$msg"
    write_summary error "$code" "$msg"
    exit "$code"
  }

  cc_info "平台=$PLATFORM  输出=$OUT"

  case "$PLATFORM" in
    unknown)
      fail 2 "无法识别的链接（支持抖音、小红书、X、YouTube、微信公众号）"
      ;;
    douyin)
      bash "$SKILL_DIR/scripts/douyin.sh" "$URL" "$OUT"
      st=$?
      [ "$st" -eq 0 ] || fail "$st" "抖音下载失败（退出码 $st）"
      ;;
    xhs)
      bash "$SKILL_DIR/scripts/xhs.sh" "$URL" "$OUT"
      st=$?
      [ "$st" -eq 0 ] || fail "$st" "小红书下载失败（退出码 $st）"
      ;;
    x|youtube)
      bash "$SKILL_DIR/scripts/ytdlp.sh" "$URL" "$OUT"
      st=$?
      [ "$st" -eq 0 ] || fail "$st" "$PLATFORM 下载失败（退出码 $st）"
      ;;
    wechat)
      if [ ! -x "$SKILL_DIR/wxfetch/wxfetch" ]; then
        fail 3 "找不到 wxfetch 脚本"
      fi
      set +e
      "$SKILL_DIR/wxfetch/wxfetch" "$URL" --out "$OUT" --format both --download-images -q >"$OUT/wxfetch_stdout.json"
      st=$?
      set -e
      if [ "$st" -ne 0 ]; then
        fail 6 "公众号抓取失败（wxfetch 退出码 $st）"
      fi
      write_summary ok 0 "公众号抓取成功"
      exit 0
      ;;
  esac

  # 抖音图集 / 小红书图文：只有图片和文案，不送去转录
  local KIND
  KIND="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8")).get("kind") or "")' "$OUT/meta.json" 2>/dev/null || true)"
  if [ "$KIND" = images ]; then
    write_summary ok 0 "图集/图文：已保存图片和文案（无需转录）"
    exit 0
  fi

  if [ "$SKIP_TRANSCRIBE" = 1 ]; then
    write_summary ok 0 "下载成功（已跳过转录）"
    exit 0
  fi

  # 转录语言：--language / CC_LANGUAGE 优先；否则抖音、小红书用 zh，X、YouTube 自动识别
  if [ -z "$LANGUAGE" ]; then
    case "$PLATFORM" in
      douyin|xhs) LANGUAGE=zh ;;
      *) LANGUAGE=auto ;;
    esac
  fi

  local MEDIA
  MEDIA="$(python3 - <<'PY' "$OUT"
import json, sys
from pathlib import Path
out = Path(sys.argv[1])
media = []
exts = {".mp4", ".m4a", ".mp3", ".webm", ".mkv", ".mov", ".wav", ".aac", ".opus"}
meta = out / "meta.json"
if meta.exists():
    try:
        data = json.loads(meta.read_text(encoding="utf-8"))
        for f in data.get("files") or []:
            p = Path(f)
            if p.is_file() and p.suffix.lower() in exts:
                media.append(str(p))
    except Exception:
        pass
if not media:
    media = [str(p) for p in out.rglob("*") if p.is_file() and p.suffix.lower() in exts and p.stat().st_size > 0]
print(media[0] if media else "")
PY
)"

  if [ -z "$MEDIA" ]; then
    fail 4 "下载看起来成功，但没有找到可转录的媒体文件"
  fi

  local PYBIN="${CC_VENV}/bin/python"
  if [ ! -x "$PYBIN" ]; then
    fail 3 "找不到转录环境: $CC_VENV （先运行 content-capture setup，或设置 CC_VENV）"
  fi

  local TRANS_ARGS=("$PYBIN" "$SKILL_DIR/scripts/transcribe.py" --out-dir "$OUT" --language "$LANGUAGE" "$MEDIA")
  if [ -n "$MAX_SECONDS" ]; then
    TRANS_ARGS+=(--max-seconds "$MAX_SECONDS")
    cc_info "转录 $MEDIA （语言 $LANGUAGE，仅前 ${MAX_SECONDS} 秒）"
  else
    cc_info "转录 $MEDIA （语言 $LANGUAGE）"
  fi
  set +e
  "${TRANS_ARGS[@]}"
  st=$?
  set -e
  case "$st" in
    0) ;;
    3) fail 3 "转录依赖缺失（ffmpeg / ffprobe / faster-whisper，见上方日志）" ;;
    4) fail 5 "转录失败：媒体文件损坏或不是音视频，ffprobe 读不了（transcribe.py 退出码 4）" ;;
    7) fail 5 "转录失败：媒体没有音轨（transcribe.py 退出码 7）" ;;
    *) fail 5 "转录失败（transcribe.py 退出码 $st）" ;;
  esac
  if [ ! -s "$OUT/transcript_plain.txt" ]; then
    # 有音轨但没识别出人声（比如纯音乐）：不算失败，但明确说文案为空
    cc_info "有音轨，但没有识别出人声，文案为空"
    write_summary ok 0 "下载并转录完成，但没有识别出人声（文案为空）"
    exit 0
  fi

  write_summary ok 0 "下载并转录成功"
  exit 0
}

# ---------- 分派 ----------
if [ $# -eq 0 ]; then
  cmd_help >&2
  exit 1
fi

case "$1" in
  collect) shift; cmd_collect "$@" ;;
  detect) shift; cmd_detect "$@" ;;
  setup) shift; cmd_setup "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  transcribe) shift; cmd_transcribe "$@" ;;
  index) shift; cmd_index "$@" ;;
  help|-h|--help) cmd_help; exit 0 ;;
  --version|-V|version) cmd_version; exit 0 ;;
  *)
    cc_err "未知命令: $1"
    cmd_help >&2
    exit 1
    ;;
esac
